<div class="row">
    <div class="col-lg-3 col-6">
        <div class="small-box bg-info">
            <div class="inner">
                <h3>@ViewBag.NewOrders</h3>
                <p>Đơn hàng hiện có</p> @* hoặc: "Tổng số đơn hàng" *@
            </div>
            <div class="icon">
                <i class="ion ion-bag"></i>
            </div>
            <a asp-area="Admin" asp-controller="Orders" asp-action="Index" class="small-box-footer">
                Xem thêm <i class="fas fa-arrow-circle-right"></i>
            </a>
        </div>
    </div>

    <div class="col-lg-3 col-6">
        <div class="small-box bg-success">
            <div class="inner">
                <h3>@ViewBag.TotalProducts</h3>
                <p>Sản phẩm</p>
            </div>
            <div class="icon">
                <i class="ion ion-stats-bars"></i>
            </div>
            <a asp-area="Admin" asp-controller="Products" asp-action="Index" class="small-box-footer">
                Xem thêm <i class="fas fa-arrow-circle-right"></i>
            </a>
        </div>
    </div>

    <div class="col-lg-3 col-6">
        <div class="small-box bg-warning">
            <div class="inner">
                <h3>@ViewBag.TotalUsers</h3>
                <p>Tổng người dùng</p>
            </div>
            <div class="icon">
                <i class="ion ion-person"></i>
            </div>
            <a asp-area="Admin" asp-controller="Users" asp-action="Index" class="small-box-footer">
                Xem thêm <i class="fas fa-arrow-circle-right"></i>
            </a>
        </div>
    </div>

    <div class="col-lg-3 col-6">
        <div class="small-box bg-danger">
            <div class="inner">
                <h3>@ViewBag.TotalAdmins</h3>
                <p>Tài khoản Admin</p>
            </div>
            <div class="icon">
                <i class="ion ion-person-stalker"></i> @* hoặc: ion-lock-combination *@
            </div>
            <a asp-area="Admin" asp-controller="UserRoles" asp-action="Index" class="small-box-footer">
                Xem thêm <i class="fas fa-arrow-circle-right"></i>
            </a>
        </div>
    </div>
</div>